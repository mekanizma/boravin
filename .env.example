# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=tr
NEXT_PUBLIC_DEFAULT_CURRENCY=TRY

# Database
# Supabase Session Pooler (IPv4 — copy exact host from Dashboard → Connect):
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres
# Direct connection is IPv6-only on free tier and often fails on home/office networks.
# Local (no Docker): PGlite
# DATABASE_PROVIDER=pglite
# DATABASE_URL=pglite:./data/boravin
# Docker Postgres example:
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://boravin:boravin@localhost:5432/boravin
#
# Render Postgres (internal URL from Blueprint / Dashboard → Connect):
# DATABASE_PROVIDER=postgres
# DATABASE_SSL=require
# DATABASE_URL=postgresql://boravin:****@dpg-xxxx-a/boravin

# Supabase API (Auth — app Render'da olsa bile Auth Supabase'de kalır)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Auth.js
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_URL=http://localhost:3000

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Free-tier text model. Google Search grounding is not included on the free tier.
GEMINI_MODEL=gemini-3.8-flash
# Cloud project number (digits only, or projects/<number>)
GEMINI_PROJECT=
AI_IMAGE_PROVIDER=gemini

# Storage (local filesystem by default — no MinIO/Docker needed)
STORAGE_PROVIDER=local
STORAGE_BUCKET=boravin-media
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=
# Render persistent disk (scripts/start-render.mjs public/uploads'a symlink eder)
# UPLOADS_DIR=/var/data/uploads

# Payments (mock by default)
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=

# Shipping
SHIPPING_PROVIDER=mock

# Email
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@boravin.com

# Analytics
ANALYTICS_PROVIDER=internal

# WhatsApp / Waai AI storefront API (Bearer token)
# Generate a long random string and paste the same value in Waai "API Token".
WAAI_API_TOKEN=
# Optional tighter limits for /api/v1/*
# WAAI_RATE_LIMIT_WINDOW_MS=60000
# WAAI_RATE_LIMIT_MAX=120

# Outbound WhatsApp when admin changes order status (optional)
# Prefer a webhook (Waai / n8n / custom) that sends the message:
# WHATSAPP_NOTIFY_WEBHOOK_URL=https://...
# WHATSAPP_NOTIFY_WEBHOOK_TOKEN=
# Or Meta Cloud API (text needs 24h window; templates for proactive):
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_STATUS_TEMPLATE=order_status_update
# WHATSAPP_STATUS_TEMPLATE_LANG=tr
# WHATSAPP_NOTIFY_STATUSES=accepted,preparing,shipped,delivered,cancelled


# Barcode lookup (optional — improves electronics coverage)
# Free Open Icecat works without keys; Full Icecat needs both:
# ICECAT_USERNAME=
# ICECAT_APP_KEY=
# UPCitemdb trial works without a key (rate-limited); paid key raises limits:
# UPCITEMDB_USER_KEY=
# Google web fallback uses local Chrome/Edge (set BARCODE_GOOGLE_HEADLESS=0 to disable).
# On Render leave headless off (no Chrome):
# BARCODE_GOOGLE_HEADLESS=0
# Optional Serper key for API-based Google search:
# SERPER_API_KEY=
